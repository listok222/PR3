using System;
using System.Collections.Generic;

namespace TextAnalyzerApp
{
    class TextStats
    {
        public string OriginalText;
        public int WordCount;
        public string ShortestWord;
        public string LongestWord;
        public int SentenceCount;
        public int VowelCount;
        public int ConsonantCount;
        public Dictionary<char, int> LetterFrequency = new Dictionary<char, int>();
    }

    class Program
    {
        static List<char> Vowels = new List<char> { 'а', 'е', 'ё', 'и', 'о', 'у', 'ы', 'э', 'ю', 'я' };
        static List<char> Consonants = new List<char> { 'б', 'в', 'г', 'д', 'ж', 'з', 'й', 'к', 'л', 'м', 'н', 'п', 'р', 'с', 'т', 'у', 'ф', 'х', 'ц', 'ч', 'ш', 'щ' };

        static void Main(string[] args)
        {
            List<TextStats> history = new List<TextStats>();
            bool running = true;

            while (running)
            {
                Console.WriteLine("Меню");
                Console.WriteLine("1 новый текст");
                Console.WriteLine("2 история");
                Console.WriteLine("3 выход");

                string choice = Console.ReadLine();

                if (choice == "1")
                {
                    string text = ReadTextFromUser();
                    TextStats stats = AnalyzeText(text);
                    history.Add(stats);
                    PrintStats(stats);
                }
                else if (choice == "2")
                {
                    ShowHistory(history);
                }
                else if (choice == "3")
                {
                    running = false;
                }
                else
                {
                    Console.WriteLine("Неизвестная команда");
                }
            }
        }

        static string ReadTextFromUser()
        {
            while (true)
            {
                Console.WriteLine("\nВведите текст (минимум 100 символов):");
                string text = Console.ReadLine() ?? "";

                if (text.Length >= 100)
                {
                    return text;
                }

                Console.WriteLine($"Слишком короткий текст Вы ввели {text.Length}  Нужно {100 - text.Length}.");
            }
        }

        static TextStats AnalyzeText(string text)
        {
            TextStats stats = new TextStats();
            stats.OriginalText = text;

            char[] separators = { ' ', '\n' };
            string[] rawWords = text.Split(separators, StringSplitOptions.RemoveEmptyEntries);

            string shortest = null;
            string longest = null;
            int validWordCount = 0;

            char[] punctuation = { '.', ',', '!', '?', '-', ':', ';', '(', ')', '"', '«', '»' };

            foreach (string rawWord in rawWords)
            {
                string cleanWord = rawWord.Trim(punctuation);

                if (cleanWord.Length > 0)
                {
                    validWordCount++;
                    if (shortest == null)
                    {
                        shortest = cleanWord;
                    }
                    else
                    {
                        if (cleanWord.Length < shortest.Length)
                        {
                            shortest = cleanWord;
                        }
                    }

                    if (longest == null)
                    {
                        longest = cleanWord;
                    }
                    else
                    {
                        if (cleanWord.Length > longest.Length)
                        {
                            longest = cleanWord;
                        }
                    }
                }
            }

            stats.WordCount = validWordCount;
            stats.ShortestWord = shortest;
            stats.LongestWord = longest;
            stats.SentenceCount = CountSentences(text);

            foreach (char originalChar in text)
            {
                char c = char.ToLower(originalChar);

                if (Vowels.Contains(c))
                {
                    stats.VowelCount++;
                }
                else if (Consonants.Contains(c))
                {
                    stats.ConsonantCount++;
                }

                if (char.IsLetter(c))
                {
                    if (stats.LetterFrequency.ContainsKey(c))
                    {
                        stats.LetterFrequency[c]++;
                    }
                    else
                    {
                        stats.LetterFrequency[c] = 1;
                    }
                }
            }

            return stats;
        }

        static int CountSentences(string text)
        {
            int count = 0;
            bool insideTerminator = false;

            foreach (char c in text)
            {
                bool isTerminator = false;
                if (c == '.') isTerminator = true;
                if (c == '!') isTerminator = true;
                if (c == '?') isTerminator = true;

                if (isTerminator)
                {
                    if (!insideTerminator)
                    {
                        count++;
                    }
                }
                insideTerminator = isTerminator;
            }

            return count;
        }

        static void PrintStats(TextStats stats)
        {
            Console.WriteLine("\nРезультаты");
            Console.WriteLine($"всего слов: {stats.WordCount}");
            Console.WriteLine($"cамое короткое: '{stats.ShortestWord}'");
            Console.WriteLine($"cамое длинное: '{stats.LongestWord}'");
            Console.WriteLine($"предложений: {stats.SentenceCount}");
            Console.WriteLine($"гласных: {stats.VowelCount}");
            Console.WriteLine($"согласных: {stats.ConsonantCount}");

            Console.WriteLine("Частота букв:");
            foreach (var pair in stats.LetterFrequency)
            {
                Console.WriteLine($"  '{pair.Key}': {pair.Value} раз");
            }
        }

        static void ShowHistory(List<TextStats> history)
        {
            if (history.Count == 0)
            {
                Console.WriteLine("История пуста");
                return;
            }

            for (int i = 0; i < history.Count; i++)
            {
                Console.WriteLine($" Текст {i + 1}");
                Console.WriteLine($"Текст: \"{history[i].OriginalText}\"");
                PrintStats(history[i]);
            }
        }
    }
}
